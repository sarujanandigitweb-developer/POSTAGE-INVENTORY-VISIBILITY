# Copy to .env at the repo root and fill in the real values. NEVER commit .env.
# .gitignore already excludes .env and *.env, and allows this template only.
#
# One file serves everything: the 2-hourly refresh, both Next.js apps, and the hub
# publish. Nothing else reads credentials — sql/refresh/db.js and the apps'
# lib/pg-core.js are the only readers, and hub/publish.sh composes HUB_DB_URL from
# the PG* block below at run time and unsets it again.

# --- LEDSone PostgreSQL (read-only role: tech_user) -------------------------
# The source of every figure on both deliverables. Connection limit is 10 for this
# role, shared with pgAdmin and the cron refresh, so pools are capped deliberately.
LEDSONE_HOST=169.58.91.229
LEDSONE_PORT=5432
LEDSONE_DB=ledsone
LEDSONE_USER=tech_user
LEDSONE_PASSWORD=
# 'require' (default) or 'disable'. Anything else is treated as require with
# rejectUnauthorized:false.
LEDSONE_SSLMODE=require

# --- Varman AIOS hub (publish target of the HTML dashboard) -----------------
# hub/publish.sh and hub/verify.sh build HUB_DB_URL from exactly these five keys.
# This is the shared hub database, not the LEDSone one.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Optional, never stored here -------------------------------------------
# Set in the process environment when you need them; they have working defaults.
#
#   LEDSONE_DATA_TTL=300        seconds a built dataset is served before a rebuild.
#                               Read ONCE at module load from the process env, not
#                               from this file. Both apps.
#   LEDSONE_MAX_STALE=3600      v2 only: oldest copy still served while a rebuild
#                               runs behind the request.
#   LEDSONE_STALE=0             v2 only: turn stale-while-revalidate off.
#   LEDSONE_KEEP_WARM=0         v2 only: turn the keep-warm sweep off.
#   LEDSONE_SKIP_WARM=1         v2 only: skip the warm-up at boot.
#   LEDSONE_INVENTORY_ENGINE=sql  v2 only: DB-side inventory pagination. Measured
#                               slower than the default 'memory'; leave unset.
#   PORT=3021                   v2 only: the boot warm fetches 127.0.0.1:$PORT and
#                               defaults to 3020, which is v1's port. Set it to
#                               3021 when running v2, or its warm-up hits v1.
#   PGSSL=require               forces TLS on the hub connection.
